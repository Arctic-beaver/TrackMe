root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cjs,css,html,js,json,jsonc,jsx,mjs,scss,ts,tsx}]
indent_style = tab
indent_size = 4

[*.{md,mdx}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
