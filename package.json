{
	"name": "tiempio",
	"version": "0.1.0",
	"description": "A calm local-first planner for personal goals and tasks",
	"main": "./out/main/index.js",
	"author": "Tiempio",
	"homepage": "https://tiempio.com",
	"license": "UNLICENSED",
	"private": true,
	"scripts": {
		"repo:audit": "node scripts/repository-policy.mjs",
		"brand:audit": "node scripts/brand-policy.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint --cache .",
		"lint:fix": "eslint --cache --fix .",
		"i18n:audit": "node scripts/i18n-policy.mjs src/renderer/src",
		"theme:audit": "node scripts/theme-policy.mjs src/renderer/src/styles/main.css",
		"ui:audit": "node scripts/ui-policy.mjs src/renderer/src",
		"test": "tsc -p tsconfig.test.json && node --test --experimental-test-isolation=none \".test-out/**/*.test.js\" && npm run test:scripts",
		"test:scripts": "node --test --experimental-test-isolation=none \"scripts/*.test.mjs\"",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "npm run typecheck:node && npm run typecheck:web",
		"bundle:audit": "node scripts/bundle-policy.mjs out/renderer",
		"precommit": "npm run repo:audit && npm run brand:audit && npm run format:check && npm run lint && npm run i18n:audit && npm run theme:audit && npm run ui:audit && npm test && npm run typecheck",
		"quality": "npm run precommit",
		"ensure:electron": "install-electron --no",
		"prestart": "npm run ensure:electron",
		"start": "electron-vite preview",
		"predev": "npm run ensure:electron",
		"dev": "electron-vite dev",
		"build": "npm run typecheck && electron-vite build && npm run bundle:audit",
		"check:security": "node scripts/security-policy.mjs",
		"prepackage:check": "npm run ensure:electron",
		"package:check": "electron-builder --dir",
		"check:packaged-contents": "node scripts/packaged-content-policy.mjs",
		"check:electron-fuses": "node scripts/electron-fuse-policy.mjs",
		"check:packaged-smoke": "node scripts/packaged-smoke.mjs",
		"release:check": "npm run quality && npm run build && npm run check:security && npm run package:check && npm run check:packaged-contents && npm run check:electron-fuses && npm run check:packaged-smoke",
		"postinstall": "npm run ensure:electron && electron-builder install-app-deps",
		"prepare": "simple-git-hooks",
		"build:win": "npm run build && electron-builder --win",
		"build:mac": "npm run build && electron-builder --mac",
		"build:linux": "npm run build && electron-builder --linux"
	},
	"dependencies": {
		"@electron-toolkit/utils": "4.0.0"
	},
	"devDependencies": {
		"@electron-toolkit/eslint-config-prettier": "3.0.0",
		"@electron-toolkit/eslint-config-ts": "3.1.0",
		"@electron-toolkit/tsconfig": "2.0.0",
		"@electron/asar": "3.4.1",
		"@electron/fuses": "2.1.3",
		"@types/node": "22.20.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.2.0",
		"electron": "43.1.0",
		"electron-builder": "26.15.3",
		"electron-vite": "5.0.0",
		"eslint": "9.39.5",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.4.26",
		"lucide-react": "1.25.0",
		"prettier": "3.9.5",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"simple-git-hooks": "2.13.1",
		"typescript": "5.9.3",
		"vite": "7.3.6"
	},
	"simple-git-hooks": {
		"pre-commit": "npm run precommit"
	}
}
