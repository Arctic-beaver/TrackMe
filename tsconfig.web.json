{
	"extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
	"include": [
		"src/renderer/src/**/*.ts",
		"src/renderer/src/**/*.tsx",
		"src/renderer/src/**/*.d.ts",
		"src/shared/**/*.ts"
	],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
	"compilerOptions": {
		"composite": true,
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"baseUrl": ".",
		"paths": {
			"@renderer/*": ["src/renderer/src/*"],
			"@shared/*": ["src/shared/*"]
		}
	}
}
